{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "bili Audio",
  "mainBinaryName": "bili-audio",
  "version": "1.0.0",
  "identifier": "com.biliaudio.app",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "bili Audio",
        "width": 420,
        "height": 780,
        "minWidth": 360,
        "minHeight": 600,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "shadow": true,
        "center": true,
        "url": "biliaudio://localhost/"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  }
}
