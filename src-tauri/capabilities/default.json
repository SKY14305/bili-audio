{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "默认权限集：主窗口加载自定义协议（本地源），允许窗口控制与拖拽",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-start-resize-dragging",
    "dialog:default",
    "dialog:allow-save",
    "dialog:allow-open"
  ]
}
